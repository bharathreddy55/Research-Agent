# ResearchAgent Environment Variables Template
# Copy this file to .env and configure your keys

# LLM Providers (Default: gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI Provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Search Providers (Default: tavily)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Budget Cap in Paise (100 paise = 1 INR)
DEFAULT_BUDGET_CAP_PAISE=1500
