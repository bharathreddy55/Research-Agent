# ResearchAgent Environment Variables Template
# Copy this file to .env and configure your keys

# Local sign-in: JSON object mapping lowercase usernames to BCrypt hashes.
# Generate a hash using scripts/hash-password.ps1 after compiling; see README.
# Single quotes preserve the dollar signs when Docker Compose reads .env.
# No default account is provided; the web server refuses to start when empty.
AUTH_USERS_JSON='{}'
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Set true when serving the API over HTTPS.
AUTH_COOKIE_SECURE=false

# LLM Providers: gemini or openai require their selected API key.
# Select mock explicitly for labeled demo output without model API calls.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI Provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Search Providers (Default: tavily)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Budget Cap in Paise (100 paise = 1 INR)
DEFAULT_BUDGET_CAP_PAISE=1500
